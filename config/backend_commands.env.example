# Copy to config/backend_commands.env and edit for your server.
# Then run:
#   source config/backend_commands.env
# before starting the gateway.
#
# Every command below can use:
#   $TTS_TEXT
#   $TTS_VOICE
#   $TTS_LANGUAGE
#   $TTS_OUTPUT_PATH
#   $TTS_OUTPUT_FORMAT

# Mesolitica example placeholder
export TTS_CMD_MESOLITICA='python -m mesolitica_backend --text "$TTS_TEXT" --voice "${TTS_VOICE:-default}" --output "$TTS_OUTPUT_PATH"'

# Kokoro example placeholder
export TTS_CMD_KOKORO='python -m kokoro_backend --text "$TTS_TEXT" --voice "${TTS_VOICE:-af_alloy}" --output "$TTS_OUTPUT_PATH"'

# Piper (already has dedicated wrapper; optional override)
# export TTS_CMD_PIPER='bash scripts/run_piper.sh "$TTS_TEXT" "$TTS_VOICE" "$TTS_OUTPUT_PATH"'

# MeloTTS
export TTS_CMD_MELOTTS='python -m melotts_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

# XTTS v2
export TTS_CMD_XTTS_V2='python -m xtts_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --language "${TTS_LANGUAGE:-en}" --output "$TTS_OUTPUT_PATH"'

# Fish Speech
export TTS_CMD_FISH_SPEECH='python -m fish_speech_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

# Chatterbox
export TTS_CMD_CHATTERBOX='python -m chatterbox_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

# VibeVoice
export TTS_CMD_VIBEVOICE='python -m vibevoice_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

# TinyTTS
export TTS_CMD_TINYTTS='python -m tinytts_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

# Voxtral
export TTS_CMD_VOXTRAL='python -m voxtral_backend --text "$TTS_TEXT" --voice "$TTS_VOICE" --output "$TTS_OUTPUT_PATH"'

