[Unit]
Description=Mesolitica TTS Flask API
After=network.target

[Service]
Type=simple
User=andy
WorkingDirectory=/home/andy/mesolitica-tts
Environment=MESOLITICA_TTS_HOST=0.0.0.0
Environment=MESOLITICA_TTS_PORT=5500
Environment=MESOLITICA_TTS_VOICE=yasmin
Environment=MESOLITICA_TTS_FORMAT=wav
Environment=MESOLITICA_TTS_PRELOAD=true
ExecStart=/home/andy/mesolitica-tts/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
