[Unit]
Description=Voxpro Multi-Engine TTS Gateway
After=network.target

[Service]
Type=simple
User=andy
WorkingDirectory=/home/andy/mesolitica-tts
Environment=TTS_CONFIG_PATH=/home/andy/mesolitica-tts/config/engines.yaml
ExecStart=/home/andy/mesolitica-tts/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
